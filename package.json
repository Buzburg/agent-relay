{
  "name": "agent-relay",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Rehearse how separate automations and agents relay events to each other, before connecting real accounts.",
  "bin": {
    "agent-relay": "./dist/agent-relay.mjs",
    "agent-relay-harness": "./dist/agent-relay-harness.mjs"
  },
  "keywords": [
    "ai-agents",
    "automation",
    "zapier",
    "make",
    "n8n",
    "langchain",
    "infinite-loop",
    "model-checker",
    "webhook",
    "rehearsal",
    "circuit-breaker"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "overrides": {"playwright-core": "1.58.2"}
}
